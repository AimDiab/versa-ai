# ---------------------------------------------------------------
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ---------------------------------------------------------------

# Which LLM provider to use: "openai" or "anthropic"
ACTIVE_PROVIDER=openai

# OpenAI — required when ACTIVE_PROVIDER=openai
# Also used for embeddings when ACTIVE_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Anthropic — required when ACTIVE_PROVIDER=anthropic
# Embeddings will run locally via fastembed (no key needed)
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/versaai

# ----- Optional overrides -----

# Completion model to use (defaults shown below)
# OPENAI_COMPLETION_MODEL=gpt-4o-mini
# ANTHROPIC_COMPLETION_MODEL=claude-haiku-4-5

# OpenAI embedding model (only relevant when ACTIVE_PROVIDER=openai)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# fastembed model (only relevant when ACTIVE_PROVIDER=anthropic)
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Embedding vector dimensions — auto-derived from provider if not set
# openai/text-embedding-3-small = 1536 | fastembed/bge-small-en-v1.5 = 384
# EMBEDDING_DIMENSIONS=1536

# Relevance guard threshold (0.0–1.0). Queries scoring below this are deflected.
# RELEVANCE_THRESHOLD=0.70
